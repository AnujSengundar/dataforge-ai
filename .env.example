DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dataforge
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
APP_ENV=development
PROFILE_HIGH_NULL_THRESHOLD=0.40
PROFILE_CATEGORICAL_UNIQUE_RATIO_THRESHOLD=0.05
PROFILE_IDENTIFIER_UNIQUE_RATIO_THRESHOLD=0.98
PROFILE_TYPE_COERCION_SAMPLE_SIZE=1000
PROFILE_SAMPLE_VALUES=5
PROFILE_CATEGORY_VALUE_LIMIT=25
NULL_RATE_DRIFT_THRESHOLD=5.0
CARDINALITY_DRIFT_THRESHOLD=0.20
NUMERIC_DRIFT_THRESHOLD=0.20
QUALITY_ROW_WEIGHT=0.70
QUALITY_RULE_WEIGHT=0.30
